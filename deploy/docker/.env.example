# Copy to .env and fill in. Never commit .env.
# A long random value, for example: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
POSTGRES_PASSWORD=

# Sign-in: an OpenID Connect provider (WorkOS AuthKit, Auth0, Clerk, Cognito, Keycloak...). Create an application
# there with the redirect URL  <PUBLIC_URL>/auth/callback  and paste its values here.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# where browsers reach this app, for example https://aero.example.com:8080
PUBLIC_URL=
# 0: only invited email addresses can sign in. 1: anyone who signs in gets an organization of their own.
SIGNUP_OPEN=0
# optional: email invitations through Resend (https://resend.com); the From domain must be verified there
RESEND_API_KEY=
MAIL_FROM=
