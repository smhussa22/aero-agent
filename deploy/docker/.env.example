# Copy to .env and fill in. Never commit .env.
# A long random value, for example: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
POSTGRES_PASSWORD=

# Sign-in: an OpenID Connect provider (WorkOS AuthKit, Auth0, Clerk, Cognito, Keycloak...). Create an application
# there with the redirect URL  <PUBLIC_URL>/auth/callback  and paste its values here.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# where browsers reach this app, for example https://aero.example.com:8080
PUBLIC_URL=
# 0: only invited email addresses can sign in. 1: anyone who signs in gets an organization of their own.
SIGNUP_OPEN=0
# optional: email invitations through Resend (https://resend.com); the From domain must be verified there
RESEND_API_KEY=
MAIL_FROM=
# host:port that monitored servers stream to, as they reach it from outside, for example aero.example.com:50051.
# Needed for the one-line installer (Hosts page -> add server).
GATEWAY_PUBLIC_ADDR=

# Sign-in with email and password through Supabase Auth (https://supabase.com), on our own login page. Create a project,
# then: Authentication > Providers > Email > turn on "Confirm email"; Project Settings > API: copy the URL and the
# anon (public) key here. New projects already use the asymmetric signing keys this needs.
# Set SIGNUP_OPEN=1 above to let anyone create an account; 0 keeps it to invited email addresses.
SUPABASE_URL=
SUPABASE_ANON_KEY=
